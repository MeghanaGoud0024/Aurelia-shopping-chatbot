# ---------------------------------------------------------------------------
# Aurelia AI Shopping Assistant - environment configuration
# Copy to `.env` and fill in. Every value below has a safe default except
# AURELIA_LLM_API_KEY, which is required for live LLM responses.
# ---------------------------------------------------------------------------

# --- LLM provider (any OpenAI-compatible API) -----------------------------
# Two supported shapes, both free:
#
#   1. Hosted (default below). Groq's free tier. Fast, but capped at 8,000
#      tokens/minute AND 200,000 tokens/day - the daily cap is per-organisation,
#      not per-key, so issuing a second key does not raise it.
#
#   2. Local, via Ollama (https://ollama.com) - no key, no quota, no network:
#        ollama pull llama3.2:3b
#        AURELIA_LLM_BASE_URL=http://localhost:11434/v1
#        AURELIA_LLM_MODEL=llama3.2:3b
#        AURELIA_LLM_API_KEY=            # leave empty; local needs no key
#        AURELIA_GUARD_INJECTION_MODEL=  # leave empty; see Guardrails below
#        AURELIA_LLM_REASONING_EFFORT=   # leave empty; gpt-oss-only parameter
#      The model must support tool calling or the assistant cannot work at
#      all - llama3.2, qwen2.5 and mistral-nemo do; plain llama2 does not.
AURELIA_LLM_API_KEY=
AURELIA_LLM_BASE_URL=https://api.groq.com/openai/v1
AURELIA_LLM_MODEL=openai/gpt-oss-120b
AURELIA_LLM_TEMPERATURE=0.15
AURELIA_LLM_MAX_TOKENS=1600
AURELIA_LLM_REASONING_EFFORT=low
AURELIA_LLM_TIMEOUT_SECONDS=60
AURELIA_LLM_MAX_RETRIES=3

# --- Guardrail models -----------------------------------------------------
# Prompt Guard 2 returns a jailbreak/injection probability in [0,1].
# Leave EMPTY to skip this layer entirely - correct when the provider does not
# host a jailbreak classifier (e.g. a local Ollama runtime), where it would
# otherwise fire one guaranteed-to-fail request per turn. The deterministic
# pattern layer runs regardless, and authorisation never depended on this.
AURELIA_GUARD_INJECTION_MODEL=meta-llama/llama-prompt-guard-2-86m
AURELIA_GUARD_INJECTION_THRESHOLD=0.85
AURELIA_GUARD_ENABLED=true

# --- Agent loop -----------------------------------------------------------
AURELIA_MAX_TOOL_ITERATIONS=6
AURELIA_MAX_TOOL_CALLS_PER_TURN=10
AURELIA_TOOL_ROUTING_ENABLED=true

# --- Application ----------------------------------------------------------
AURELIA_DATABASE_URL=sqlite:///./data/aurelia.db
AURELIA_ENVIRONMENT=development
AURELIA_LOG_LEVEL=INFO
AURELIA_SEED=20260830

# --- Rate limiting (per session, sliding window) --------------------------
AURELIA_RATE_LIMIT_REQUESTS=30
AURELIA_RATE_LIMIT_WINDOW_SECONDS=60
